[Unit]
Description=grandMA2 onPC Web Remote bridge for Cherry keyboard and ASL encoders
Documentation=file:/opt/ma2pi/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ma2pi
Group=ma2pi
SupplementaryGroups=audio
WorkingDirectory=/opt/ma2pi/app
ExecStart=/opt/ma2pi/.venv/bin/python -m ma2pi --config /etc/ma2pi/config.toml
Restart=always
RestartSec=5
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077

# Hardening: no root, read-only filesystem, private tmp.  Device access is
# granted by the udev rule (GROUP=ma2pi, MODE=0660) on the Cherry evdev node
# and the ASL raw MIDI node; PrivateDevices=false keeps the real /dev visible.
# A path-glob DeviceAllow= was tried, but its device-cgroup filter denied
# access (EPERM) on cgroup v2, so access is controlled via the udev group.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
