# grandMA2 onPC bridge: allow the ma2pi service user to read/write configured
# controller nodes without granting broad audio/input group privileges.
# Install to /etc/udev/rules.d/99-ma2pi.rules and reload:
#   udevadm control --reload-rules
#   udevadm trigger --subsystem-match=input --subsystem-match=sound

# Cherry POS Keyboard G86-63400EUADAA (vendor 0x046a), evdev.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="046a", GROUP="ma2pi", MODE="0660"

# ASL MK2 E4B3 (04d8:e817) and MIDICRAFT family (vendor 0x04d8, e.g. ENC 04d8:e78c)
# expose ALSA rawmidi nodes (/dev/snd/midiC*D*).
SUBSYSTEM=="sound", KERNEL=="midiC*", ATTRS{idVendor}=="04d8", GROUP="ma2pi", MODE="0660"
